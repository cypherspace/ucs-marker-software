# Local dev — copy to .env and fill in values.
# Never commit .env.

DATABASE_URL=postgresql://marker:marker@localhost:5435/marker_db

# Google OAuth (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set to 'true' during development to bypass Google login
AUTH_DISABLED=false

# Set to 'true' to allow any Google account to create a teacher account
ALLOW_SIGNUP=false

# Gemini API key (stored in Secret Manager in production)
GOOGLE_API_KEY=

# Storage backend: 'local' or 'gcs'
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# In production only — GCS bucket name
STORAGE_BUCKET=

# Python extractor URL
EXTRACTOR_URL=http://localhost:8081

# Cookie security (false for local http dev)
COOKIE_SECURE=false
