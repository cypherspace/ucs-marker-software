# Local dev — copy to .env and fill in values.
# Never commit .env.

DATABASE_URL=postgresql://marker:marker@localhost:5435/marker_db

# Google OAuth (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set to 'true' during development to bypass Google login
AUTH_DISABLED=false

# Set to 'true' to allow any Google account to create a teacher account
ALLOW_SIGNUP=false

# Gemini API key (stored in Secret Manager in production)
GOOGLE_API_KEY=

# Storage backend: 'local' or 'gcs'
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# In production only — GCS bucket name
STORAGE_BUCKET=

# Python extractor URL
EXTRACTOR_URL=http://localhost:8081

# Cookie security (false for local http dev)
COOKIE_SECURE=false

# AES-256-GCM key for encrypting Google Drive refresh tokens (32 bytes = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Frontend Google Drive Picker (optional — plain file upload is used if unset)
# VITE_GOOGLE_CLIENT_ID: same OAuth client as GOOGLE_OAUTH_CLIENT_ID
# VITE_GOOGLE_API_KEY: browser API key with the Google Picker API enabled
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
